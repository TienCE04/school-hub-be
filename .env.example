# Bind to all network interfaces so phones on the same Wi-Fi can reach the API.
HOST=0.0.0.0
PORT=3000

# Generate a random 32-byte key and Base64-encode it. Keep the real value private.
ATTENDANCE_FACE_ENCRYPTION_KEY_BASE64=

# Server-only cosine similarity threshold; calibrate against the selected Android model.
ATTENDANCE_FACE_SIMILARITY_THRESHOLD=

# Proposed enrollment retention. Consent revocation deletes active samples immediately.
ATTENDANCE_FACE_RETENTION_DAYS=365
