generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            Int                            @id @default(autoincrement())
  name                          String
  email                         String                         @unique
  studentCode                   String?                        @unique
  password                      String
  avatar                        String?
  role                          Role
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  joinRequests                  ClassJoinRequest[]
  classMembers                  ClassMember[]
  comments                      Comment[]                      @relation("UserComments")
  deviceTokens                  DeviceToken[]
  driveFiles                    DriveFile[]
  messages                      Message[]                      @relation("UserMessages")
  participants                  Participant[]
  posts                         Post[]                         @relation("UserPosts")
  profile                       Profile?
  tokens                        RefreshToken[]
  subjectMembers                SubjectMember[]
  submissions                   Submission[]                   @relation("UserSubmissions")
  leaveRequests                 LeaveRequest[]                 @relation("UserLeaveRequests")
  attendanceSessionsLed         AttendanceSession[]            @relation("AttendanceSessionTeacher")
  attendanceRecords             AttendanceRecord[]             @relation("AttendanceRecordStudent")
  attendanceRecordsReviewed     AttendanceRecord[]             @relation("AttendanceRecordReviewer")
  attendanceReviews             AttendanceReview[]             @relation("AttendanceReviewReviewer")
  attendanceDevices             AttendanceDevice[]             @relation("AttendanceDeviceOwner")
  attendanceSessionParticipants AttendanceSessionParticipant[] @relation("AttendanceParticipantStudent")
  attendanceAuditLogs           AttendanceAuditLog[]           @relation("AttendanceAuditActor")
  faceProfile                   FaceProfile?
}

model Class {
  id                 Int                 @id @default(autoincrement())
  name               String
  description        String?
  code               String              @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  joinRequests       ClassJoinRequest[]
  members            ClassMember[]
  driveFiles         DriveFile[]
  posts              Post[]
  subject            Subject?
  leaveRequests      LeaveRequest[]
  attendanceSessions AttendanceSession[]
}

model ClassMember {
  id                            Int                            @id @default(autoincrement())
  userId                        Int
  classId                       Int
  joinedAt                      DateTime                       @default(now())
  status                        ClassMemberStatus              @default(ACTIVE)
  leftAt                        DateTime?
  class                         Class                          @relation(fields: [classId], references: [id], onDelete: Cascade)
  user                          User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceSessionParticipants AttendanceSessionParticipant[]

  @@unique([userId, classId])
  @@index([classId, status])
}

model ClassJoinRequest {
  id        Int               @id @default(autoincrement())
  userId    Int
  classId   Int
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  class     Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
}

model Post {
  id          Int          @id @default(autoincrement())
  title       String
  content     String
  type        PostType
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  authorId    Int
  classId     Int
  attachments Attachment[]
  comments    Comment[]
  author      User         @relation("UserPosts", fields: [authorId], references: [id])
  class       Class        @relation(fields: [classId], references: [id])
  submissions Submission[]
}

model Comment {
  id          Int          @id @default(autoincrement())
  content     String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  postId      Int
  authorId    Int
  attachments Attachment[]
  author      User         @relation("UserComments", fields: [authorId], references: [id])
  post        Post         @relation(fields: [postId], references: [id])
}

model Submission {
  id          Int              @id @default(autoincrement())
  submittedAt DateTime?
  grade       Float?
  feedback    String?
  status      SubmissionStatus @default(PENDING)
  postId      Int
  studentId   Int
  attachments Attachment[]
  post        Post             @relation(fields: [postId], references: [id])
  student     User             @relation("UserSubmissions", fields: [studentId], references: [id])

  @@unique([studentId, postId])
}

model Attachment {
  id           Int         @id @default(autoincrement())
  name         String
  url          String
  mimeType     String
  size         Int?
  postId       Int?
  commentId    Int?
  submissionId Int?
  messageId    Int?
  comment      Comment?    @relation(fields: [commentId], references: [id])
  message      Message?    @relation(fields: [messageId], references: [id])
  post         Post?       @relation(fields: [postId], references: [id])
  submission   Submission? @relation(fields: [submissionId], references: [id])
}

model Conversation {
  id           Int              @id @default(autoincrement())
  name         String?
  avatar       String?
  type         ConversationType @default(PRIVATE)
  privateKey   String?          @unique
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  messages     Message[]
  participants Participant[]

  @@index([updatedAt])
}

model Participant {
  id             Int          @id @default(autoincrement())
  userId         Int
  conversationId Int
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, conversationId])
  @@index([conversationId])
}

model Message {
  id             Int          @id @default(autoincrement())
  content        String
  isEdited       Boolean      @default(false)
  isDeleted      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  senderId       Int
  conversationId Int
  attachments    Attachment[]
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  sender         User         @relation("UserMessages", fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Semester {
  id           Int       @id @default(autoincrement())
  semesterName String
  startDate    DateTime
  endDate      DateTime
  totalWeeks   Int
  weekRanges   Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  subjects     Subject[]
}

model Subject {
  id                 Int                 @id @default(autoincrement())
  title              String
  subjectCode        String
  classCode          String
  location           String
  startTime          DateTime
  endTime            DateTime
  startDate          DateTime
  classId            Int?                @unique
  semesterId         Int
  session            SessionType
  class              Class?              @relation(fields: [classId], references: [id])
  semester           Semester            @relation(fields: [semesterId], references: [id])
  members            SubjectMember[]
  attendanceSessions AttendanceSession[]
}

model SubjectMember {
  id        Int      @id @default(autoincrement())
  userId    Int
  subjectId Int
  joinedAt  DateTime @default(now())
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model DriveFile {
  id        Int      @id @default(autoincrement())
  name      String
  url       String
  mimeType  String
  size      Float
  isShared  Boolean  @default(false)
  ownerId   Int
  classId   Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class     Class?   @relation(fields: [classId], references: [id])
  owner     User     @relation(fields: [ownerId], references: [id])
}

model Profile {
  id            Int     @id @default(autoincrement())
  phone         String?
  birthDate     String?
  story         String?
  emailPersonal String?
  nameSchool    String?
  nameClass     String?
  major         String?
  department    String?
  title         String?
  userId        Int     @unique
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum PostType {
  ANNOUNCEMENT
  ASSIGNMENT
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConversationType {
  PRIVATE
  GROUP
}

enum SessionType {
  MORNING
  AFTERNOON
  EVENING
}

model LeaveRequest {
  id                Int                @id @default(autoincrement())
  studentId         Int
  classId           Int
  date              DateTime
  reason            String
  evidence          String?
  status            LeaveRequestStatus @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  student           User               @relation("UserLeaveRequests", fields: [studentId], references: [id], onDelete: Cascade)
  class             Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]

  @@index([studentId])
  @@index([classId])
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Attendance domain. The source of truth for the final result is the backend;
// mobile offline data is represented as an attempt waiting for synchronization.
model AttendanceDevice {
  id              Int                    @id @default(autoincrement())
  deviceKey       String                 @unique
  name            String?
  type            AttendanceDeviceType   @default(TEACHER_PHONE)
  status          AttendanceDeviceStatus @default(ACTIVE)
  ownerId         Int
  secretHash      String?
  firmwareVersion String?
  lastSeenAt      DateTime?
  pairedAt        DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  owner           User                   @relation("AttendanceDeviceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  sessions        AttendanceSession[]

  @@index([ownerId, status])
}

model AttendanceSession {
  id             Int                            @id @default(autoincrement())
  classId        Int
  subjectId      Int?
  teacherId      Int
  deviceId       Int?
  sessionCode    String                         @unique
  attendanceDate DateTime                       @db.Date
  startsAt       DateTime
  expiresAt      DateTime
  endedAt        DateTime?
  status         AttendanceSessionStatus        @default(DRAFT)
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  class          Class                          @relation(fields: [classId], references: [id], onDelete: Restrict)
  subject        Subject?                       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher        User                           @relation("AttendanceSessionTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  device         AttendanceDevice?              @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  config         AttendanceSessionConfig?
  participants   AttendanceSessionParticipant[]
  records        AttendanceRecord[]
  challenges     AttendanceSessionChallenge[]
  auditLogs      AttendanceAuditLog[]

  @@index([classId, attendanceDate])
  @@index([teacherId, startsAt])
  @@index([status, expiresAt])
}

model AttendanceSessionConfig {
  id                           Int               @id @default(autoincrement())
  sessionId                    Int               @unique
  requireBle                   Boolean           @default(true)
  requireFace                  Boolean           @default(true)
  faceLivenessRequired         Boolean           @default(true)
  allowLate                    Boolean           @default(true)
  allowManualReview            Boolean           @default(true)
  allowOfflineAttempt          Boolean           @default(true)
  lateAfterMinutes             Int               @default(0)
  maxAttemptSeconds            Int               @default(90)
  bleRssiThreshold             Int?
  bleMinScanCount              Int               @default(1)
  bleScanDurationSeconds       Int               @default(10)
  faceSimilarityThreshold      Float?
  faceLivenessChallengeSeconds Int               @default(30)
  bleTokenHash                 String?
  bleTokenExpiresAt            DateTime?
  bleStartedAt                 DateTime?
  bleStoppedAt                 DateTime?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
  session                      AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model AttendanceSessionParticipant {
  id                  Int                         @id @default(autoincrement())
  sessionId           Int
  studentId           Int
  classMemberId       Int?
  studentCodeSnapshot String?
  studentNameSnapshot String?
  status              AttendanceParticipantStatus @default(ACTIVE)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  session             AttendanceSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student             User                        @relation("AttendanceParticipantStudent", fields: [studentId], references: [id], onDelete: Restrict)
  classMember         ClassMember?                @relation(fields: [classMemberId], references: [id], onDelete: SetNull)

  @@unique([sessionId, studentId])
  @@index([sessionId, status])
  @@index([studentId, createdAt])
}

model AttendanceRecord {
  id                 Int                          @id @default(autoincrement())
  sessionId          Int
  studentId          Int
  leaveRequestId     Int?
  status             AttendanceStatus             @default(PENDING)
  verificationStatus AttendanceVerificationStatus @default(NOT_STARTED)
  source             AttendanceRecordSource       @default(ONLINE)
  attemptedAt        DateTime?
  checkedInAt        DateTime?
  finalScore         Float?
  note               String?
  reviewedById       Int?
  reviewedAt         DateTime?
  reviewNote         String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  session            AttendanceSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student            User                         @relation("AttendanceRecordStudent", fields: [studentId], references: [id], onDelete: Restrict)
  leaveRequest       LeaveRequest?                @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  reviewedBy         User?                        @relation("AttendanceRecordReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  attempts           AttendanceAttempt[]
  reviews            AttendanceReview[]

  @@unique([sessionId, studentId])
  @@index([sessionId, status])
  @@index([studentId, createdAt])
  @@index([leaveRequestId])
}

model AttendanceAttempt {
  id                Int                          @id @default(autoincrement())
  recordId          Int
  clientAttemptId   String                       @unique
  status            AttendanceAttemptStatus      @default(PENDING_SYNC)
  source            AttendanceRecordSource       @default(ONLINE)
  clientDeviceId    String?
  clientRecordedAt  DateTime?
  initiatedAt       DateTime?
  submittedAt       DateTime?
  serverReceivedAt  DateTime?
  latitude          Float?
  longitude         Float?
  locationAccuracyM Float?
  networkType       String?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  record            AttendanceRecord             @relation(fields: [recordId], references: [id], onDelete: Cascade)
  bleEvidence       AttendanceBleEvidence?
  faceVerification  AttendanceFaceVerification?
  challenges        AttendanceSessionChallenge[]

  @@index([recordId, createdAt])
  @@index([status, serverReceivedAt])
  @@index([clientDeviceId])
}

model AttendanceBleEvidence {
  id                    Int                      @id @default(autoincrement())
  attemptId             Int                      @unique
  advertisedDeviceKey   String?
  advertisedSessionCode String?
  tokenFingerprint      String?
  rssiMin               Int?
  rssiMax               Int?
  rssiAverage           Float?
  scanCount             Int                      @default(0)
  scanDurationMs        Int?
  firstSeenAt           DateTime?
  lastSeenAt            DateTime?
  status                AttendanceEvidenceStatus @default(PENDING)
  verifiedAt            DateTime?
  failureReason         String?
  createdAt             DateTime                 @default(now())
  attempt               AttendanceAttempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([advertisedDeviceKey])
  @@index([status, createdAt])
}

model AttendanceFaceVerification {
  id                 Int                      @id @default(autoincrement())
  attemptId          Int                      @unique
  challengeType      AttendanceChallengeType?
  challengeHash      String?
  challengeExpiresAt DateTime?
  modelName          String?
  modelVersion       String?
  embeddingDimension Int?
  similarityScore    Float?
  livenessScore      Float?
  qualityScore       Float?
  status             AttendanceEvidenceStatus @default(PENDING)
  evidenceUrl        String?
  processedAt        DateTime?
  failureReason      String?
  createdAt          DateTime                 @default(now())
  attempt            AttendanceAttempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
}

model AttendanceSessionChallenge {
  id               Int                            @id @default(autoincrement())
  sessionId        Int
  attemptId        Int?
  type             AttendanceSessionChallengeType
  faceAction       AttendanceChallengeType?
  challengeHash    String
  tokenFingerprint String?
  nonce            String?
  issuedAt         DateTime
  expiresAt        DateTime
  singleUse        Boolean                        @default(false)
  consumedAt       DateTime?
  createdAt        DateTime                       @default(now())
  session          AttendanceSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attempt          AttendanceAttempt?             @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@index([sessionId, type, expiresAt])
  @@index([challengeHash])
  @@index([attemptId])
}

model FaceProfile {
  id                 Int                   @id @default(autoincrement())
  userId             Int                   @unique
  status             FaceProfileStatus     @default(NOT_ENROLLED)
  modelName          String?
  modelVersion       String?
  consentAt          DateTime?
  enrolledAt         DateTime?
  consentVersion     String?
  consentRevokedAt   DateTime?
  retentionExpiresAt DateTime?
  revokedReason      String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  samples            FaceEmbeddingSample[]
}

model FaceEmbeddingSample {
  id           Int         @id @default(autoincrement())
  profileId    Int
  embedding    Json
  dimension    Int
  modelName    String
  modelVersion String
  sampleType   String?
  qualityScore Float?
  yaw          Float?
  pitch        Float?
  roll         Float?
  sourceUrl    String?
  capturedAt   DateTime?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  profile      FaceProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, isActive])
}

model AttendanceReview {
  id                         Int                           @id @default(autoincrement())
  recordId                   Int
  reviewerId                 Int
  decision                   AttendanceReviewDecision
  note                       String?
  previousStatus             AttendanceStatus?
  newStatus                  AttendanceStatus?
  previousVerificationStatus AttendanceVerificationStatus?
  newVerificationStatus      AttendanceVerificationStatus?
  reasonCode                 String?
  createdAt                  DateTime                      @default(now())
  record                     AttendanceRecord              @relation(fields: [recordId], references: [id], onDelete: Cascade)
  reviewer                   User                          @relation("AttendanceReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([recordId, createdAt])
  @@index([reviewerId, createdAt])
}

model AttendanceAuditLog {
  id         Int                   @id @default(autoincrement())
  actorId    Int?
  sessionId  Int?
  action     AttendanceAuditAction
  entityType String
  entityId   Int?
  metadata   Json?
  createdAt  DateTime              @default(now())
  actor      User?                 @relation("AttendanceAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  session    AttendanceSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

enum AttendanceDeviceType {
  TEACHER_PHONE
  ESP32
}

enum AttendanceDeviceStatus {
  PENDING
  ACTIVE
  REVOKED
  OFFLINE
}

enum AttendanceSessionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum AttendanceStatus {
  PENDING
  PRESENT
  LATE
  ABSENT
  EXCUSED
  REVIEW
  REJECTED
}

enum AttendanceVerificationStatus {
  NOT_STARTED
  VERIFYING
  VERIFIED
  REVIEW_REQUIRED
  REJECTED
}

enum AttendanceRecordSource {
  ONLINE
  OFFLINE
  MANUAL
}

enum AttendanceAttemptStatus {
  PENDING_SYNC
  RECEIVED
  VERIFYING
  VERIFIED
  PENDING_REVIEW
  REJECTED
  EXPIRED
}

enum AttendanceEvidenceStatus {
  PENDING
  VERIFIED
  FAILED
  REVIEW_REQUIRED
}

enum AttendanceChallengeType {
  BLINK
  SMILE
  TURN_LEFT
  TURN_RIGHT
  NOD
}

enum FaceProfileStatus {
  NOT_ENROLLED
  PENDING
  ACTIVE
  SUSPENDED
}

enum AttendanceReviewDecision {
  APPROVE
  REJECT
  MARK_PRESENT
  MARK_ABSENT
  MARK_EXCUSED
}

enum ClassMemberStatus {
  ACTIVE
  LEFT
  SUSPENDED
}

enum AttendanceParticipantStatus {
  ACTIVE
  REMOVED
}

enum AttendanceSessionChallengeType {
  BLE_TOKEN
  FACE_CHALLENGE
}

enum AttendanceAuditAction {
  CREATE_SESSION
  START_SESSION
  STOP_SESSION
  FINALIZE_SESSION
  CREATE_ATTEMPT
  CANCEL_ATTEMPT
  REVIEW_RECORD
  MANUAL_UPDATE_RECORD
  PAIR_DEVICE
  REVOKE_DEVICE
  ENROLL_FACE
  SUSPEND_FACE_PROFILE
}
