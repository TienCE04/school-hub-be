// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum PostType {
  ANNOUNCEMENT
  ASSIGNMENT
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

enum ConversationType {
  PRIVATE
  GROUP
}

enum SessionType {
  MORNING
  AFTERNOON
  EVENING
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  studentCode String? @unique
  password  String
  avatar    String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens RefreshToken[]

  classMembers ClassMember[]
  subjectMembers SubjectMember[]

  posts       Post[]       @relation("UserPosts")
  comments    Comment[]    @relation("UserComments")
  submissions Submission[] @relation("UserSubmissions")

  participants Participant[]
  messages     Message[]     @relation("UserMessages")
  driveFiles   DriveFile[]

  profile      Profile?
}

model Class {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  code        String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts    Post[]
  members  ClassMember[]
  subjects Subject[]
  driveFiles DriveFile[]
}

model ClassMember {
  id        Int      @id @default(autoincrement())
  userId    Int
  classId   Int
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([userId, classId])
}

model Post {
  id      Int       @id @default(autoincrement())
  title   String
  content String
  type    PostType
  dueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId Int
  author   User @relation("UserPosts", fields: [authorId], references: [id])

  classId Int
  class   Class @relation(fields: [classId], references: [id])

  attachments Attachment[]
  comments    Comment[]
  submissions Submission[]
}

model Comment {
  id      Int    @id @default(autoincrement())
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postId Int
  post   Post @relation(fields: [postId], references: [id])

  authorId Int
  author   User @relation("UserComments", fields: [authorId], references: [id])

  attachments Attachment[]
}

model Submission {
  id          Int              @id @default(autoincrement())
  submittedAt DateTime?
  grade       Float?
  feedback    String?
  status      SubmissionStatus @default(PENDING)

  postId Int
  post   Post @relation(fields: [postId], references: [id])

  studentId Int
  student   User @relation("UserSubmissions", fields: [studentId], references: [id])

  attachments Attachment[]
}

model Attachment {
  id       Int    @id @default(autoincrement())
  name     String
  url      String
  mimeType String
  size     Int?

  postId Int?
  post   Post? @relation(fields: [postId], references: [id])

  commentId Int?
  comment   Comment? @relation(fields: [commentId], references: [id])

  submissionId Int?
  submission   Submission? @relation(fields: [submissionId], references: [id])

  messageId Int?
  message   Message? @relation(fields: [messageId], references: [id])
}

model Conversation {
  id     Int              @id @default(autoincrement())
  name   String?
  avatar String?
  type   ConversationType @default(PRIVATE)

  privateKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages     Message[]
  participants Participant[]

  @@index([updatedAt])
}

model Participant {
  id             Int      @id @default(autoincrement())
  userId         Int
  conversationId Int
  lastReadAt     DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([userId, conversationId])
  @@index([conversationId])
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now())

  senderId Int
  sender   User @relation("UserMessages", fields: [senderId], references: [id])

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  attachments Attachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Semester {
  id           Int      @id @default(autoincrement())
  semesterName String
  startDate    DateTime
  endDate      DateTime
  totalWeeks   Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subjects Subject[]
}

model Subject {
  id          Int      @id @default(autoincrement())
  title       String
  subjectCode String
  classCode   String
  location    String
  startTime   DateTime
  endTime     DateTime
  startDate   DateTime

  classId Int?
  class   Class? @relation(fields: [classId], references: [id])

  semesterId Int
  semester   Semester @relation(fields: [semesterId], references: [id])

  weekRanges Json

  session SessionType

  members SubjectMember[]
}

model SubjectMember {
  id        Int      @id @default(autoincrement())
  userId    Int
  subjectId Int
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model DriveFile {
  id          Int      @id @default(autoincrement())
  name        String
  url         String
  mimeType    String
  size        Float    // File size in bytes (using Float to support > 2GB without BigInt serialization issues)
  isShared    Boolean  @default(false)
  
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id])

  classId     Int?
  class       Class?   @relation(fields: [classId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Profile {
  id            Int      @id @default(autoincrement())
  phone         String?
  birthDate     String?
  story         String?  @db.Text
  emailPersonal String?
  nameSchool    String?
  nameClass     String?
  major         String?
  department    String?
  title         String?

  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
