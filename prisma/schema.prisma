// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum PostType {
  ANNOUNCEMENT
  ASSIGNMENT
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  LATE
  GRADED
}

enum ConversationType {
  PRIVATE
  GROUP
}

model User {
  id        Int   @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokens RefreshToken[]

  classes Class[] @relation("ClassMembers")

  posts       Post[]       @relation("UserPosts")
  comments    Comment[]    @relation("UserComments")
  submissions Submission[] @relation("UserSubmissions")

  participants Participant[]
  messages     Message[] @relation("UserMessages")
}

model Class {
  id Int @id @default(autoincrement())
  name String
  description String?
  code String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]
  users User[] @relation("ClassMembers")
}

model Post {
  id Int @id @default(autoincrement())
  title String
  content String
  type PostType
  dueDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId Int
  author User @relation("UserPosts", fields: [authorId], references: [id])

  classId Int
  class Class @relation(fields: [classId], references: [id])

  attachments Attachment[]
  comments    Comment[]
  submissions Submission[]
}

model Comment {
  id Int @id @default(autoincrement())
  content String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postId Int
  post Post @relation(fields: [postId], references: [id])

  authorId Int
  author User @relation("UserComments", fields: [authorId], references: [id])

  attachments Attachment[]
}

model Submission {
  id          Int @id @default(autoincrement())
  submittedAt DateTime?
  grade       Float?
  feedback    String?
  status      SubmissionStatus @default(PENDING)

  postId Int
  post Post @relation(fields: [postId], references: [id])

  studentId Int
  student User @relation("UserSubmissions", fields: [studentId], references: [id])

  attachments Attachment[]
}

model Attachment {
  id        Int @id @default(autoincrement())
  name      String
  url       String
  mimeType  String
  size      Int?

  postId Int?
  post   Post? @relation(fields: [postId], references: [id])

  commentId Int?
  comment   Comment? @relation(fields: [commentId], references: [id])

  submissionId Int?
  submission   Submission? @relation(fields: [submissionId], references: [id])

  messageId Int?
  message   Message? @relation(fields: [messageId], references: [id])
}

model Conversation {
  id Int @id @default(autoincrement())
  name String?
  avatar String?
  type ConversationType @default(PRIVATE)

  privateKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  participants Participant[]

  @@index([updatedAt])
}

model Participant {
  id Int @id @default(autoincrement())
  userId Int
  conversationId Int
  lastReadAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  @@unique([userId, conversationId])
  @@index([conversationId])
}

model Message {
  id Int @id @default(autoincrement())
  content String @db.Text
  createdAt DateTime @default(now())

  senderId Int
  sender User @relation("UserMessages", fields: [senderId], references: [id])

  conversationId Int
  conversation Conversation @relation(fields: [conversationId], references: [id])

  attachments Attachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model RefreshToken {
  id        Int @id @default(autoincrement())
  token     String @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}